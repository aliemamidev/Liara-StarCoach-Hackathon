LIARA_AI_BASE_URL=https://api.gapgpt.app/v1
LIARA_AI_MODEL=gpt-5.6-luna
LIARA_AI_API_KEY=
LIARA_AI_TTS_MODEL=gpt-4o-mini-tts
LIARA_AI_TTS_VOICE=alloy
LIARA_DOCS_SEARCH_URL=https://search.liara.ir
LIARA_DOCS_SEARCH_KEY=
