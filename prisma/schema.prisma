generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum KnowledgeSourceType {
  ADMIN
  DOCS
  WEB
}

enum EscalationStatus {
  PENDING
  ANSWERED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  name         String
  passwordHash String
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  chats        Chat[]
  knowledgeEntries KnowledgeEntry[]
  answeredEscalations EscalationTicket[] @relation("EscalationAnsweredBy")

  @@index([role])
  @@index([isActive])
}

model AdminSettings {
  id                    String   @id @default("default")
  captureUnknownTopics  Boolean  @default(true)
  notifyFailures        Boolean  @default(true)
  webSearchEnabled      Boolean  @default(true)
  probableAnswersEnabled Boolean  @default(true)
  autoEscalationEnabled Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Chat {
  id             String    @id
  title          String
  titleGenerated Boolean   @default(false)
  ownerTokenHash String?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  escalations    EscalationTicket[]

  @@index([userId])
  @@index([ownerTokenHash])
  @@index([updatedAt])
}

model Message {
  id        String   @id
  chatId    String
  role      String
  parts     Json
  metadata  Json?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model KnowledgeEntry {
  id                 String              @id @default(cuid())
  question           String
  normalizedQuestion String
  answer             String
  sourceType         KnowledgeSourceType @default(ADMIN)
  sourceRefs         Json                @default("[]")
  tags               String[]            @default([])
  isActive           Boolean             @default(true)
  usageCount         Int                 @default(0)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  escalationTickets  EscalationTicket[]

  @@index([normalizedQuestion])
  @@index([isActive])
  @@index([sourceType])
}

model EscalationTicket {
  id                   String           @id @default(cuid())
  chatId               String
  userQuestion         String
  clarifiedQuestion    String
  conversationSnapshot Json
  attachmentsSnapshot  Json
  searchTrace          Json
  guestName            String?
  guestPhone           String?
  status               EscalationStatus @default(PENDING)
  adminAnswer          String?
  answeredById         String?
  answeredAt           DateTime?
  knowledgeEntryId     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  chat                 Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  answeredBy           User?            @relation("EscalationAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  knowledgeEntry       KnowledgeEntry? @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)

  @@index([chatId, status])
  @@index([status, updatedAt])
  @@index([knowledgeEntryId])
  @@index([guestPhone])
}
