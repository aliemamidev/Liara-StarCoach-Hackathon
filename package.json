    "build": "npm run sitemap && npm run fetch:models && next build",
    "start": "next start",
    "lint": "eslint \"src/components/chat/*.jsx\" \"src/components/admin/*.jsx\" \"src/components/login-form.jsx\" \"src/components/ui/*.jsx\" \"src/hooks/*.js\" \"src/lib/*.js\" \"src/pages/api/*.js\" \"src/pages/docs/*.js\" \"src/pages/index.js\" \"src/pages/admin/index.js\" \"src/pages/_app.js\" \"src/pages/_document.js\"",
    "sitemap": "node sitemap/generate.js",
    "fetch:models": "node src/scripts/fetch-liara-ai-models.js",
    "prepare": "npx husky install || echo husky skipped",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:auth": "node scripts/test-auth.mjs"
  },
